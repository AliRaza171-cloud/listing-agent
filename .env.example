# Shared by all services in docker-compose. Each service reads only what it needs.
# NEVER commit the real .env.

POSTGRES_PASSWORD=change-me

# Port the gateway listens on at http://localhost:<port>. Use another (e.g. 8100) if 8000 is busy.
GATEWAY_PORT=8000
REDIS_URL=redis://redis:6379/0

# Proves a request came through the gateway or another service. Long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_TOKEN=

# Signs users' login tokens (auth issues, gateway verifies). Different random string.
JWT_SECRET=

# Encrypts sellers' store API keys (store service). Generate once, back it up —
# changing it makes every saved store connection unreadable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Local development: allow connecting stores at http:// addresses (your own Smart Click at
# http://localhost:8000). Set false in production.
ALLOW_HTTP_STORES=true

# Public address of this API once Listing Agent is online (e.g. https://api.yourdomain.com).
# WooCommerce downloads product photos from here. Leave empty while running on your PC.
PUBLIC_BASE_URL=

ALLOWED_ORIGINS=["http://localhost:3000"]
APP_URL=http://localhost:3000

# AI: "stub" = fixed sample text, no key, no cost. "gemini" = Google Gemini. "openai" = OpenAI.
#  gemini: key from https://aistudio.google.com (free tier works; web search in research needs billing)
#  openai: key from https://platform.openai.com/api-keys (prepaid credit needed). AI_MODEL empty =
#          gpt-6-luna, backup gpt-5-mini. Research uses model knowledge (no web search).
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
# Backup model, used automatically when AI_MODEL is overloaded or unavailable
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_WEB_SEARCH=true

# Voice: "stub" = always hears the same sentence. "gemini" or "openai" = real speech-to-text
# (same key as the AI is fine; openai uses gpt-4o-mini-transcribe unless STT_MODEL says otherwise).
STT_PROVIDER=stub
STT_API_KEY=
STT_MODEL=gemini-3.8-flash
STT_FALLBACK_MODEL=gemini-3.5-flash-lite
EMAIL_PROVIDER=log

SIGNUP_FREE_CREDITS=10
CREDITS_PER_LISTING=1

# ---------------- Payments (credit packs) ----------------
# Packs on sale (JSON on one line). Prices are placeholders — change them to yours.
# PKR = what Safepay charges; Stripe charges the price for STRIPE_CURRENCY.
CREDIT_PACKS=[{"id":"starter","name":"Starter","credits":50,"prices":{"PKR":999,"USD":4}},{"id":"growth","name":"Growth","credits":200,"prices":{"PKR":2999,"USD":12}},{"id":"pro","name":"Pro","credits":600,"prices":{"PKR":7499,"USD":29}}]

# Safepay — JazzCash, EasyPaisa, Pakistani cards. Keys: Safepay dashboard → Developers.
# Leave SAFEPAY_API_KEY empty to hide the Safepay button.
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_V1_SECRET=
SAFEPAY_WEBHOOK_SECRET=
# Webhook URL to enter in Safepay: <your gateway>/api/billing/webhooks/safepay

# Stripe — international cards. Keys: dashboard.stripe.com → Developers → API keys.
# Leave STRIPE_SECRET_KEY empty to hide the Stripe button.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Webhook URL to enter in Stripe: <your gateway>/api/billing/webhooks/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
#  checkout.session.async_payment_failed, checkout.session.expired)

# ---------------- One-click store connections ----------------
# WooCommerce "Connect" works automatically once Listing Agent is online (needs PUBLIC_BASE_URL).
# Shopify "Connect" needs Listing Agent's own Shopify app (one-time, see deploy/README.md):
# Shopify Dev Dashboard -> create app -> redirect URL <PUBLIC_BASE_URL>/api/store/connect/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Daraz (open.daraz.com → App Console, after Daraz approves your developer account).
# App callback URL:  <PUBLIC_BASE_URL>/api/store/connect/daraz/callback
# Leave empty to hide the "Connect Daraz" button. Like Shopify, it needs Listing Agent online (https).
DARAZ_APP_KEY=
DARAZ_APP_SECRET=
# eBay (developer.ebay.com → Application Keys, Production keyset). Needs Listing Agent online (https).
# EBAY_CLIENT_ID = "App ID (Client ID)", EBAY_CLIENT_SECRET = "Cert ID (Client Secret)".
# EBAY_RU_NAME: User Tokens → "Get a Token from eBay via Your Application" → add a redirect URL; eBay shows
#   its RuName. Auth accepted + declined URL: <PUBLIC_BASE_URL>/api/store/connect/ebay/callback
# EBAY_VERIFICATION_TOKEN: any 32–80 letters/digits you choose; enter the same one in Alerts & Notifications →
#   Marketplace account deletion, endpoint <PUBLIC_BASE_URL>/api/store/ebay/account-deletion
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_VERIFICATION_TOKEN=

# Only change these if Daraz's docs give different addresses for Pakistan:
# DARAZ_API_URL=https://api.daraz.pk/rest
# DARAZ_AUTH_URL=https://api.daraz.com/rest
# DARAZ_AUTH_PAGE=https://api.daraz.pk
