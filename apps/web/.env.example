# Where the API gateway runs (docker compose). Use your GATEWAY_PORT.
NEXT_PUBLIC_API_URL=http://localhost:8100

# Shown on the Privacy/Terms pages as the contact address. Set the same on Vercel.
NEXT_PUBLIC_CONTACT_EMAIL=
# Listing Agent's Shopify app Client ID (public). Only needed for the app inside the Shopify admin.
NEXT_PUBLIC_SHOPIFY_API_KEY=
